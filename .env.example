# Application
ENVIRONMENT=development
DEBUG=true
PROJECT_NAME="Docvane"
SECRET_KEY="replace-with-a-secure-secret-key"
API_V1_STR="/api/v1"

# Database (PostgreSQL + pgvector)
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5433/docvane"

# Redis & Celery
REDIS_URL="redis://localhost:6379/0"
CELERY_BROKER_URL="redis://localhost:6379/0"
CELERY_RESULT_BACKEND="redis://localhost:6379/0"

# Object Storage (S3 / Cloudflare R2 / MinIO)
S3_ENDPOINT_URL="http://localhost:9000"
S3_ACCESS_KEY_ID="minioadmin"
S3_SECRET_ACCESS_KEY="minioadmin"
S3_BUCKET_NAME="docvane-documents"
S3_REGION="auto"

# LLM Providers & Embeddings
GEMINI_API_KEY=""
DEFAULT_LLM_MODEL="gemini/gemini-1.5-flash"
EMBEDDING_MODEL="BAAI/bge-small-en-v1.5"
RERANKER_MODEL="BAAI/bge-reranker-base"

# Observability
LANGFUSE_PUBLIC_KEY=""
LANGFUSE_SECRET_KEY=""
LANGFUSE_HOST="https://cloud.langfuse.com"
